{
    "shell_cmd": "g++ \"$file\" -o \"$file_base_name\" && ./$file_base_name < input.in > output.in",
    "working_dir": "${file_path}",
    "file_regex": "^(.*):([0-9]+):([0-9]+): (error|warning): (.*)",
    "selector": "source.c++",
    "variants":
    [
        {
            "name": "Run Only",
            "shell_cmd": "./$file_base_name < input.in > output.in"
        }
    ]
}
